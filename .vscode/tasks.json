{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Server",
      "type": "npm",
      "script": "server",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(.*)$",
          "endsPattern": "^(.*)$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "showReuseMessage": false
      }
    }
  ]
}
